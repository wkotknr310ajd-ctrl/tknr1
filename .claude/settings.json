{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*git*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pii_check.py\"",
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "個人情報チェック中..."
          }
        ]
      },
      {
        "matcher": "mcp__github__push_files|mcp__github__create_or_update_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pii_check.py\"",
            "timeout": 60,
            "onFailure": "block",
            "statusMessage": "個人情報チェック中..."
          }
        ]
      }
    ]
  }
}
