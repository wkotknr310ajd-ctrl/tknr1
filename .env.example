# Google Cloud Console で作成した OAuth 2.0 クライアントID（種類: ウェブ アプリケーション）
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# (任意) Google Cloud Vision API の APIキー。
# 設定すると OCR エンジンがブラウザ内 OCR (Tesseract.js) から
# Cloud Vision API に切り替わり、特に日本語名刺の認識精度が大幅に向上します。
# 未設定の場合は Tesseract.js のまま動作します。
VITE_GOOGLE_VISION_API_KEY=
